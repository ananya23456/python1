# In[20]:


import matplotlib.pyplot as plt
import numpy as np

Men=[22,30,35,35,26]
Women=[25,32,30,35,29]
groups=[1,2,3,4,5]
groups=np.arange(5)

plt.bar(groups,Men,0.3)
plt.bar(groups+0.3,Women,0.3)
plt.title(" Scores by group and gender")
plt.xlabel("group")
plt.ylabel("Scores")
plt.legend("mv")


